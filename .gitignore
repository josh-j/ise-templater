# Anything that holds a secret, and anything a run produces.

# The ISE admin password. The .example beside it is the committed template;
# the real file never is, ansible-vault encrypted or not. Ansible skips the
# .example itself -- only .yml, .yaml and .json in group_vars are loaded.
/inventory/group_vars/all/99-credentials.yml
/.vault-pass
/.env

# Raw exports carry live values -- RADIUS shared secrets, repository
# credentials, internal user records -- in cleartext. Templates are the
# artefact meant to be committed; exports are scratch. Remove this line only
# if you have decided otherwise on purpose.
exports/

*.retry
__pycache__/

# Where ansible-galaxy and ansible-lint put the roles and collections they
# install for themselves. Ours are in roles/ and are committed.
.ansible/

# uv.lock is committed; the environment it builds is not.
.venv/

# Local tooling scratch, not part of the project.
.mem-vocab/
