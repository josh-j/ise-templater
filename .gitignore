# Raw exports carry live values -- RADIUS shared secrets among them -- in
# cleartext. Templates are the artefact meant to be committed; exports are
# scratch. Remove this line only if you have decided otherwise on purpose.
exports/

# The admin password lives here. credentials.example.yml is the committed
# one; credentials.yml never is, encrypted with ansible-vault or not.
credentials.yml
.vault-pass
.env

*.retry

__pycache__/

# uv.lock is committed; the environment it builds is not.
.venv/

# Local tooling scratch, not part of the project.
.mem-vocab/
