# Anything that holds a secret, and anything a run produces.

# The ISE admin password. credentials.example.yml is the committed template;
# credentials.yml never is, ansible-vault encrypted or not. Leading slash so
# this only ever means the one in the project root.
/credentials.yml
/.vault-pass
/.env

# Raw exports carry live values -- RADIUS shared secrets, repository
# credentials, internal user records -- in cleartext. Templates are the
# artefact meant to be committed; exports are scratch. Remove this line only
# if you have decided otherwise on purpose.
exports/

*.retry
__pycache__/

# uv.lock is committed; the environment it builds is not.
.venv/

# Local tooling scratch, not part of the project.
.mem-vocab/
