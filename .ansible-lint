---
# `./ise lint`

# The strictest profile this passes. There is no skip_list: every rule from
# `production` down is met rather than switched off, so a new violation is a
# real one and not something the config was already hiding.
profile: production

exclude_paths:
  - .venv/
  - exports/
  # One .j2 per ISE object, a couple of thousand of them. They are JSON
  # documents with Jinja in them, not Ansible files; lint has nothing to say
  # about them and walking them is most of the runtime.
  - templates/
