---
# Copy this to 99-credentials.yml beside it and fill that in. The copy is
# gitignored; this file is the committed example and must never hold a real
# secret.
#
#   ./ise setup                    # copies this file for you
#   $EDITOR inventory/group_vars/all/99-credentials.yml
#
# Ansible reads every .yml in this directory as variables for every host, so
# the copy needs no wiring up -- and a directory without one simply sets
# nothing, which is why ISE_PASSWORD in the environment still works. The .yml
# is what gets read: this .example is skipped, which is why it can sit here.
#
# The 99- is the whole trick to precedence. Files are read in name order and
# the last one wins, so this lands after 01-connection.yml and replaces the
# password it works out from the environment.
#
# Precedence, first hit wins:
#
#   1. -e on the command line
#   2. 99-credentials.yml
#   3. ISE_PASSWORD in the environment
#   4. the sops store, and only with -e ise_password_sops=true

# --- the admin account -----------------------------------------------------
# This is the GUI/ERS/OpenAPI password, which on ISE is a separate credential
# from the CLI/SSH one. The account needs the ERS Admin and, for the OpenAPI
# resources, the Super Admin or equivalent role.

ise_user: admin
ise_password: "change-me"

# --- optional --------------------------------------------------------------

# Lab appliances present self-signed certificates, so verification is off by
# default. Turn it on once the target has a certificate you trust.
# ise_validate_certs: false

# What the templating tokens resolve to at apply time. The defaults in
# inventory/group_vars/all/04-templating.yml reproduce the source lab
# exactly; override them here to push your own RADIUS shared secrets instead
# of the exported ones.
# site_radius_secret_sim: "..."
# site_radius_secret_lab: "..."
# site_radius_secret_cml: "..."

# --- different credentials per appliance -----------------------------------
# This file applies to every host. When the source and target want different
# accounts, put the pair in inventory/host_vars/<node>.yml instead --
# host_vars beats group_vars:
#
#   inventory/host_vars/laba-ise-004.yml
#     ise_user: apiadmin
#     ise_password: "..."

# --- keeping it encrypted --------------------------------------------------
# 99-credentials.yml may be an ansible-vault file rather than cleartext,
# and the playbooks read it either way:
#
#   ansible-vault encrypt inventory/group_vars/all/99-credentials.yml
#   ./ise export                       # prompts for the vault password
#
# Put the vault password in .vault-pass (also gitignored) and ./ise picks it
# up without prompting.
