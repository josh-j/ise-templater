#!/usr/bin/env sh
# One entry point for the playbooks, so the flag combinations that matter -- a
# dry run, the sites file, the two switches destroy.yml insists on -- are names
# rather than something to remember. Anything it does not recognise is handed
# to ansible-playbook untouched, so `./ise export -e resources=sgt` works the
# way it reads.
#
# You do not need to know Ansible to use this. docs/ansible-for-newcomers.md
# is there for when you want to.
#
#   ./ise help
set -eu

cd "$(dirname "$0")"

# Where the ISE password goes. Ansible reads every .yml in that directory as
# variables, in name order; 99- is so this one lands last and wins.
CREDS=inventory/group_vars/all/99-credentials.yml

# The families, read out of the file that defines them rather than repeated
# here. They were two hand-synced lists -- this one and the usage text below
# -- and a family added to the families file but not to both would be
# rejected by `--with` as an unknown name.
FAMILIES_FILE=inventory/group_vars/all/02-families.yml
FAMILIES=$(sed -n 's/^ise_group_\([a-z]*\):.*/\1/p' "$FAMILIES_FILE" 2>/dev/null |
  tr '\n' ' ')
FAMILIES=${FAMILIES% }
[ -n "$FAMILIES" ] || {
  echo "ise: no ise_group_* flags found in $FAMILIES_FILE" >&2
  exit 1
}

# --- how to run ansible ----------------------------------------------------
# uv first, since it is what pyproject.toml and uv.lock are for and it brings
# the environment up to date on the way past. A .venv from the plain-pip route
# is next, and a system-wide ansible-playbook last.
if command -v uv >/dev/null 2>&1 && [ -f pyproject.toml ]; then
  # Verify TLS against the operating system's certificate store, so a network
  # that inspects TLS works without further ceremony. pyproject.toml sets the
  # same thing; this covers running uv from anywhere else too. On uv older
  # than 0.10 the spelling is UV_NATIVE_TLS=1, which this leaves alone.
  UV_SYSTEM_CERTS=${UV_SYSTEM_CERTS:-1}
  export UV_SYSTEM_CERTS
  RUN="uv run --"
elif [ -x .venv/bin/ansible-playbook ]; then
  PATH="$PWD/.venv/bin:$PATH"
  export PATH
  RUN=""
elif command -v ansible-playbook >/dev/null 2>&1; then
  RUN=""
else
  echo "ise: no ansible-playbook found. Run './ise setup' first." >&2
  exit 1
fi

# --- vault -----------------------------------------------------------------
# The credentials file may be an ansible-vault file. If it is, supply the
# password from .vault-pass when that exists and prompt when it does not --
# unless the caller is already passing vault options of their own.
vault_args() {
  [ -f "$CREDS" ] || return 0
  head -c 14 "$CREDS" 2>/dev/null | grep -q '^\$ANSIBLE_VAULT' || return 0
  case " $* " in *" --vault"* | *" --ask-vault"*) return 0 ;; esac
  if [ -f .vault-pass ]; then
    echo "--vault-password-file .vault-pass"
  else
    echo "--ask-vault-pass"
  fi
}

play() {
  playbook=$1
  shift
  # Word splitting on $RUN and the vault args is deliberate; both are ours.
  # shellcheck disable=SC2086
  set -- $RUN ansible-playbook "$playbook" $(vault_args "$@") "$@"
  echo "+ $*" >&2
  exec "$@"
}

usage() {
  cat <<'EOF'
Usage: ./ise <command> [options]

  setup                install dependencies, create the credentials file
  check                confirm every appliance answers on both APIs
  export               read configuration from ise_source into exports/
  templatize           turn exports/ into templates/exported/
  apply [--dry]        push templates/exported/ at ise_target
  sites [FILE] [--dry] push the site fan-out (default vars/sites.yml)
  destroy [FILE] [--force]
                       remove what the site templates created. Shows what it
                       would delete unless you add --force
  lint                 ansible-lint over the playbooks
  help

Options any command takes:

  --with FAMILY[,FAMILY]     include families that are off by default
  --without FAMILY[,FAMILY]  leave families out for this run

EOF
  echo "    $FAMILIES"
  cat <<'EOF'

Anything else on the line goes to ansible-playbook as-is:

  ./ise export -e resources=networkdevicegroup,networkdevice
  ./ise apply --dry -e resources=policy-set
  ./ise check --limit ise_target
  ./ise export --with portals

A first run, in order:

  ./ise setup          then put the password in the file it writes
  ./ise check
  ./ise export
  ./ise templatize
  ./ise apply --dry
EOF
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

# --dry, --force, --with and --without are ours; everything else is pushed
# back for ansible. The countdown is what stops pushed-back arguments from
# being read a second time.
dry=0
force=0
sites_file=""
families=""

add_families() { # add_families <list> <true|false>
  for name in $(echo "$1" | tr ',' ' '); do
    case " $FAMILIES " in
      *" $name "*) families="$families -e ise_group_$name=$2" ;;
      *)
        echo "ise: no such family: $name" >&2
        echo "ise: pick from: $FAMILIES" >&2
        exit 1
        ;;
    esac
  done
}

need_value() { # need_value <flag> <how many arguments are left>
  [ "$2" -gt 0 ] || {
    echo "ise: $1 needs a comma-separated family list" >&2
    exit 1
  }
}

n=$#
while [ "$n" -gt 0 ]; do
  a=$1
  shift
  n=$((n - 1))
  case $a in
    --dry | -n) dry=1 ;;
    --force | -f) force=1 ;;
    --with)
      need_value "$a" "$n"
      add_families "$1" true
      shift
      n=$((n - 1))
      ;;
    --without)
      need_value "$a" "$n"
      add_families "$1" false
      shift
      n=$((n - 1))
      ;;
    *.yml | *.yaml)
      # A bare file argument to sites/destroy is the sites file; anywhere else
      # it is an ansible argument and gets pushed back like the rest.
      case $cmd in
        sites | destroy) sites_file=$a ;;
        *) set -- "$@" "$a" ;;
      esac
      ;;
    *) set -- "$@" "$a" ;;
  esac
done

# shellcheck disable=SC2086
set -- $families "$@"

case $cmd in
  setup)
    if command -v uv >/dev/null 2>&1; then
      uv sync
    else
      echo "ise: no uv -- falling back to venv + pip" >&2
      python3 -m venv .venv
      .venv/bin/pip install --upgrade pip
      .venv/bin/pip install 'ansible-core>=2.21,<2.22'
      echo "ise: the dev tooling (ansible-lint and friends) needs uv; see README" >&2
    fi
    if [ -f "$CREDS" ]; then
      echo "ise: credentials file already exists, left alone"
    else
      cp "$CREDS.example" "$CREDS"
      chmod 600 "$CREDS"
      echo "ise: wrote $CREDS -- put the ISE admin password"
      echo "     in it, then run ./ise check"
    fi
    ;;

  check) play playbooks/check.yml "$@" ;;
  export) play playbooks/export.yml "$@" ;;
  templatize) play playbooks/templatize.yml "$@" ;;

  apply)
    [ "$dry" -eq 1 ] && set -- -e ise_dry_run=true "$@"
    play playbooks/apply.yml "$@"
    ;;

  sites)
    [ -n "$sites_file" ] || sites_file=vars/sites.yml
    if [ ! -f "$sites_file" ]; then
      echo "ise: no such sites file: $sites_file" >&2
      exit 1
    fi
    [ "$dry" -eq 1 ] && set -- -e ise_dry_run=true "$@"
    play playbooks/apply.yml -e "@$sites_file" -e ise_site_only=true "$@"
    ;;

  destroy)
    [ -n "$sites_file" ] || sites_file=vars/sites.yml
    if [ ! -f "$sites_file" ]; then
      echo "ise: no such sites file: $sites_file" >&2
      exit 1
    fi
    # destroy.yml shows what it would delete and stays that way until --force.
    # The asymmetry with apply is the point: deletes have to be asked for.
    [ "$force" -eq 1 ] && set -- -e ise_dry_run=false "$@"
    play playbooks/destroy.yml -e "@$sites_file" "$@"
    ;;

  lint)
    # shellcheck disable=SC2086
    exec $RUN ansible-lint "$@"
    ;;

  help | -h | --help) usage ;;

  *)
    echo "ise: unknown command: $cmd" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
