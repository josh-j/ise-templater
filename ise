#!/usr/bin/env sh
# One entry point for the four playbooks, so the flag combinations that matter
# -- a dry run, the sites file, the two switches destroy.yml insists on -- are
# names rather than something to remember. Anything it does not recognise is
# handed to ansible-playbook untouched, so `./ise export -e resources=sgt`
# works the way it reads.
#
#   ./ise help
set -eu

cd "$(dirname "$0")"

# --- how to run ansible ----------------------------------------------------
# uv first, since it is what pyproject.toml/uv.lock are for and it syncs the
# environment on the way past. A .venv from the plain-pip route is next, and a
# system-wide ansible-playbook last.
if command -v uv >/dev/null 2>&1 && [ -f pyproject.toml ]; then
  RUN="uv run --"
elif [ -x .venv/bin/ansible-playbook ]; then
  PATH="$PWD/.venv/bin:$PATH"
  export PATH
  RUN=""
elif command -v ansible-playbook >/dev/null 2>&1; then
  RUN=""
else
  echo "ise: no ansible-playbook. Run './ise setup' first." >&2
  exit 1
fi

# --- vault ------------------------------------------------------------------
# credentials.yml may be an ansible-vault file. If it is, supply the password
# from .vault-pass when that exists and prompt when it does not -- unless the
# caller is already passing vault options of their own.
vault_args() {
  [ -f credentials.yml ] || return 0
  head -c 14 credentials.yml 2>/dev/null | grep -q '^\$ANSIBLE_VAULT' || return 0
  case " $* " in *" --vault"*|*" --ask-vault"*) return 0 ;; esac
  if [ -f .vault-pass ]; then
    echo "--vault-password-file .vault-pass"
  else
    echo "--ask-vault-pass"
  fi
}

play() {
  playbook=$1
  shift
  # Word splitting on $RUN and the vault args is deliberate; both are ours.
  # shellcheck disable=SC2086
  set -- $RUN ansible-playbook "$playbook" $(vault_args "$@") "$@"
  echo "+ $*" >&2
  exec "$@"
}

usage() {
  cat <<'EOF'
Usage: ./ise <command> [options]

  setup                install dependencies, create credentials.yml
  check                confirm every node answers on both APIs
  export               read config from ise_source into exports/
  templatize           turn exports/ into templates/
  apply [--dry]        push templates/ at ise_target
  sites [FILE] [--dry] push the site fan-out (default sites.yml)
  destroy [FILE] [--force]
                       remove what the site templates created; dry unless
                       --force, which is the flag that actually writes
  lint                 ansible-lint over the playbooks
  help

Anything else on the line goes to ansible-playbook as-is:

  ./ise export -e resources=networkdevicegroup,networkdevice
  ./ise apply --dry -e resources=policy-set
  ./ise check --limit ise_target

Credentials come from credentials.yml (see credentials.example.yml), or from
ISE_PASSWORD in the environment. './ise setup' creates the first one for you.
EOF
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

# --dry / --force are ours; everything else is pushed back for ansible. The
# countdown is what keeps pushed-back arguments from being re-read.
dry=0
force=0
sites_file=""
n=$#
while [ "$n" -gt 0 ]; do
  a=$1
  shift
  n=$((n - 1))
  case $a in
    --dry | -n) dry=1 ;;
    --force | -f) force=1 ;;
    *.yml | *.yaml)
      # A bare file argument to sites/destroy is the sites file; anywhere else
      # it is an ansible argument and gets pushed back like the rest.
      case $cmd in
        sites | destroy) sites_file=$a ;;
        *) set -- "$@" "$a" ;;
      esac
      ;;
    *) set -- "$@" "$a" ;;
  esac
done

case $cmd in
  setup)
    if command -v uv >/dev/null 2>&1; then
      uv sync
    else
      echo "ise: no uv -- falling back to venv + pip" >&2
      python3 -m venv .venv
      .venv/bin/pip install --upgrade pip
      .venv/bin/pip install 'ansible-core>=2.21,<2.22'
      echo "ise: dev tooling (ansible-lint and friends) needs uv; see README" >&2
    fi
    if [ -f credentials.yml ]; then
      echo "ise: credentials.yml already exists, left alone"
    else
      cp credentials.example.yml credentials.yml
      chmod 600 credentials.yml
      echo "ise: wrote credentials.yml -- put the ISE admin password in it,"
      echo "     then run ./ise check"
    fi
    ;;

  check) play check.yml "$@" ;;
  export) play export.yml "$@" ;;
  templatize) play templatize.yml "$@" ;;

  apply)
    [ "$dry" -eq 1 ] && set -- -e ise_dry_run=true "$@"
    play apply.yml "$@"
    ;;

  sites)
    [ -n "$sites_file" ] || sites_file=sites.yml
    if [ ! -f "$sites_file" ]; then
      echo "ise: no such sites file: $sites_file" >&2
      exit 1
    fi
    [ "$dry" -eq 1 ] && set -- -e ise_dry_run=true "$@"
    play apply.yml -e "@$sites_file" -e ise_site_only=true "$@"
    ;;

  destroy)
    [ -n "$sites_file" ] || sites_file=sites.yml
    if [ ! -f "$sites_file" ]; then
      echo "ise: no such sites file: $sites_file" >&2
      exit 1
    fi
    # destroy.yml is dry by default and stays that way until --force. The
    # asymmetry with apply is the point: deletes have to be asked for.
    [ "$force" -eq 1 ] && set -- -e ise_dry_run=false "$@"
    play destroy.yml -e "@$sites_file" "$@"
    ;;

  lint)
    # shellcheck disable=SC2086
    exec $RUN ansible-lint "$@"
    ;;

  help | -h | --help) usage ;;

  *)
    echo "ise: unknown command: $cmd" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
